# live_caption 开发版 App 的运行产物（勿提交）
# mt_cache 是 OpenVINO/oneDNN 的内核编译缓存，实测可长到 2.4 GB
live_caption/mt_cache/
live_caption/selftest/
live_caption/runs/
live_caption/out_*.txt
*.bak_*

# WorkBuddy agent memory (local only)
.workbuddy/

# C-049 测试语料（原始包数十GB + 生成的长音频，脚本可重建）
test_data/

# C-102/TTS 运行产物（勿提交）
# npu_cache 是 OpenVINO NPU 编译缓存，实测 644 MB
live_caption/npu_cache/
# selftest_out 是 GUI 自测的截图/日志
live_caption/selftest_out/
# voices/*.npz 是 TTS 声线克隆的运行时导出物（可用 tts_worker 重建）
live_caption/voices/

# 客户包构建产物（不入库）
*.zip
Confucius4_LiveCaption_v*/

# OpenVINO/NPU 编译缓存（C-085/C-086/C-087 的 NPU CACHE_DIR，约 53 GiB，可重建）
reports/npu_cache/

# C-090#2 / C-095#4：OpenVINO IR 权重（.bin 可达 GiB 级，绝不能进仓库）。
# R0–R4 的 INT4 IR 已移到 models/c089_int4/；这里再加一道兜底，
# 防止以后有人把 IR 输出到 reports/ 下。
reports/**/*.bin
reports/**/*.xml
