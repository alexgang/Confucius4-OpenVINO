{
  "manifest_version": 3,
  "name": "Live Dub EXT (实时翻译配音)",
  "version": "0.4.24",
  "description": "抓取网页/本地视频音频流，本机 ASR→翻译→TTS，按时间戳延迟播放配音。",
  "liveDub": {
    "_comment": "★ EXT-031③：发行版开关（release/build_release.py 会改写本段）。release=true ⇒ 只保留 EXT-027 的标签页音频路径，禁用整机 getDisplayMedia 回退；开发目录里保持 false。",
    "release": false,
    "captureModes": ["tabCapture", "getDisplayMedia"]
  },
  "minimum_chrome_version": "116",
  "key": "",
  "background": {
    "service_worker": "sw.js",
    "type": "module"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "实时翻译配音",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Ctrl+Shift+Y",
        "windows": "Ctrl+Shift+Y"
      },
      "description": "启动实时翻译配音（EXT-033 A2：快捷键=用户手势）"
    }
  },
  "_comment_commands": "★ EXT-033 A2：commands._execute_action = 快捷键触发扩展动作 = **算用户手势**（Chrome 只给 _execute_action 授予 activeTab）。自动化下用 SendInput 合成按键，替代真人点扩展图标，从而让 chrome.tabCapture.getMediaStreamId({targetTabId}) 能拿到流 id。⚠️ 键值**不能含 Alt**（Chrome 判为 Invalid value for 'commands[1].default' ⇒ 扩展加载失败 ⇒ 弹『无法加载该扩展』模态框 ⇒ 浏览器起不来、CDP 永不就绪）。",
  "permissions": [
    "tabCapture",
    "offscreen",
    "storage",
    "scripting"
  ],
  "host_permissions": [
    "http://127.0.0.1/*",
    "http://localhost/*"
  ],
  "optional_host_permissions": [
    "http://*/*"
  ],
  "minimum_permissions": [],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
