{
  "manifest_version": 3,
  "name": "Live Dub EXT (实时翻译配音)",
  "version": "0.1.0",
  "description": "抓取网页/本地视频音频流，本机 ASR→翻译→TTS，按时间戳延迟播放配音。",
  "liveDub": {
    "_comment": "★ EXT-031③：发行版开关（release/build_release.py 会改写本段）。release=true ⇒ 只保留 EXT-027 的标签页音频路径，禁用整机 getDisplayMedia 回退；开发目录里保持 false。",
    "release": false,
    "captureModes": ["tabCapture", "getDisplayMedia"]
  },
  "minimum_chrome_version": "116",
  "key": "",
  "background": {
    "service_worker": "sw.js",
    "type": "module"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "实时翻译配音",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "permissions": [
    "tabCapture",
    "offscreen",
    "storage",
    "scripting"
  ],
  "host_permissions": [
    "http://127.0.0.1/*",
    "http://localhost/*"
  ],
  "minimum_permissions": [],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
